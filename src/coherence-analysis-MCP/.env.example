# Variables del servidor coherence-analysis-MCP (solo necesarias si se ejecuta
# el servidor de forma independiente; el orquestador ya se las pasa).
PYTHONUTF8=1

# Proveedor del motor LLM: "mock" (no requiere API key ni red) o "anthropic".
COHERENCE_LLM_PROVIDER="mock"

# Modelo a usar cuando el proveedor no es "mock".
COHERENCE_LLM_MODEL="claude-sonnet-5"

# API key del proveedor configurado. Nunca se hardcodea en el codigo.
COHERENCE_LLM_API_KEY="your_anthropic_api_key"

# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# --- Anthropic (API key compartida) ---
# Una sola key de Anthropic alimenta dos componentes distintos:
#   1. El modelo orquestador (este cliente).
#   2. El servidor coherence-analysis-MCP, que la recibe como
#      COHERENCE_LLM_API_KEY via la interpolacion en config/mcp_servers.yaml.
# El modelo de cada componente se configura por separado (ver abajo).
ANTHROPIC_API_KEY=""

# Modelo del orquestador. Por defecto un modelo rapido y barato para el
# loop agentico y el modo veredicto. Cambiar a claude-sonnet-5 para mas
# capacidad de razonamiento (mas costo y latencia).
ORCHESTRATOR_MODEL="claude-haiku-4-5"

# Temperatura baja para reproducibilidad de los veredictos.
ORCHESTRATOR_TEMPERATURE="0"

# --- coherence-analysis-MCP ---
# Modelo que usara internamente ese servidor (independiente del orquestador).
COHERENCE_LLM_MODEL="claude-sonnet-5"

# "anthropic" para usar el LLM real (consume la ANTHROPIC_API_KEY de arriba),
# o "mock" para correr sin key real ni llamadas de red (util para pruebas).
COHERENCE_LLM_PROVIDER="anthropic"

# --- VirusTotal (servidor de terceros) ---
# Si se deja vacia, el servidor de VirusTotal no podra responder consultas,
# pero el orquestador sigue funcionando con los demas servidores.
VIRUSTOTAL_API_KEY=""

# --- Rutas a los servidores MCP propios ---
# Rutas a las carpetas locales de cada servidor. Las rutas relativas se
# resuelven desde la carpeta del orquestador (desde donde se ejecuta
# "uv run ..."). Tambien se aceptan rutas absolutas. Nunca se hardcodean en
# el codigo ni en config/mcp_servers.yaml.
KNOWLEDGE_MCP_PATH="../knowledge-based-MCP"
PATTERN_ARCHETYPE_MCP_PATH="../pattern-archetype-MCP"
COHERENCE_MCP_PATH="../coherence-analysis-MCP"

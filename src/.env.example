# =============================================================================
# Variables de entorno del sistema de deteccion de phishing (LLM + MCP)
# =============================================================================
# Este archivo NO contiene credenciales reales. Copialo a la carpeta del
# orquestador y completa los valores:
#
#   cp src/.env.example src/phishing-detection-orchestrator/.env
#
# El orquestador lanza los tres servidores MCP propios y el de VirusTotal
# como subprocesos y les reenvia las variables necesarias
# (ver src/phishing-detection-orchestrator/config/mcp_servers.yaml).
# =============================================================================

# --- Anthropic (obligatoria) ---
# Una sola key alimenta al orquestador y al servidor coherence-analysis-MCP.
ANTHROPIC_API_KEY="your_anthropic_api_key"

# Modelo y temperatura del orquestador.
ORCHESTRATOR_MODEL="claude-haiku-4-5"
ORCHESTRATOR_TEMPERATURE="0"

# --- coherence-analysis-MCP ---
# "anthropic" usa el LLM real; "mock" corre sin key ni llamadas de red.
COHERENCE_LLM_PROVIDER="anthropic"
COHERENCE_LLM_MODEL="claude-sonnet-5"

# --- VirusTotal (opcional) ---
# Si se deja vacia, el sistema funciona sin el servidor de VirusTotal.
VIRUSTOTAL_API_KEY="your_virustotal_api_key"

# --- Rutas a los servidores MCP propios ---
# Relativas a src/phishing-detection-orchestrator/ (o rutas absolutas).
KNOWLEDGE_MCP_PATH="../knowledge-based-MCP"
PATTERN_ARCHETYPE_MCP_PATH="../pattern-archetype-MCP"
COHERENCE_MCP_PATH="../coherence-analysis-MCP"
